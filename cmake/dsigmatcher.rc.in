      VALUE "InternalName",     "dsigmatcher"
      VALUE "OriginalFilename", "dsigmatcher.exe"
      VALUE "ProductName",      "DSigMatcher Native"
      VALUE "ProductVersion",   "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
